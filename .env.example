# Configuração pública do Firebase Web SDK. Deixe vazia enquanto a
# integração não estiver habilitada. Nunca coloque service account, private
# key, client secret ou credencial administrativa em variáveis VITE_*.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=
# Somente em desenvolvimento local; nunca habilitar no deploy público.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Opt-in local. Exige que a Emulator Suite esteja em execução.
VITE_FIREBASE_USE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8080
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_STORAGE_EMULATOR_PORT=9199

# Servidor Fastify (sem prefixo VITE_). Em produção, use ADC do ambiente;
# localmente, FIREBASE_AUTH_EMULATOR_HOST evita qualquer chave privada.
CUIDACAO_FIREBASE_PROJECT_ID=cuidacao-13fc8
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
